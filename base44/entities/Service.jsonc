{
  "name": "Service",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "exterior",
        "interior",
        "full_detail",
        "add_on",
        "other"
      ],
      "default": "exterior"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "location_id",
    "name",
    "price"
  ]
}